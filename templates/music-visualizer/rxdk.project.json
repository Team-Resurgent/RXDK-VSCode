{
  "name": "my-music",
  "sources": [
    "src/main.cpp"
  ],
  "projectReferences": [
    "libs/vorbis"
  ],
  "libraries": [
    "libd3d8",
    "libdsound",
    "libxapi",
    "libc",
    "libcpp",
    "libkernel"
  ],
  "deployPaths": [
    "media"
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "outputDir": "out/Debug",
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true
      }
    },
    "Release": {
      "configuration": "release",
      "outputDir": "out/Release",
      "imageBuild": {
        "stackSize": 65536,
        "debug": false,
        "noLogo": true,
        "noLibWarn": true
      }
    }
  }
}
