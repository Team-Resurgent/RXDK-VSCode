{
  "name": "my-pad",
  "sources": [
    "src/main.c"
  ],
  "libraries": [
    "libd3d8",
    "libxgraphics",
    "libxapi",
    "libc",
    "libcpp",
    "libkernel"
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "outputDir": "out/Debug",
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true
      }
    },
    "Release": {
      "configuration": "release",
      "outputDir": "out/Release",
      "imageBuild": {
        "stackSize": 65536,
        "debug": false,
        "noLogo": true,
        "noLibWarn": true
      }
    }
  }
}
