{
  "name": "my-xmv",
  "sources": [
    "src/main.cpp"
  ],
  "libraries": [
    "libxapi",
    "libd3d8",
    "libdsound",
    "libxmv",
    "libc",
    "libcpp",
    "libkernel"
  ],
  "deployPaths": [
    "media/test.xmv"
  ],
  "embed": [
    {
      "path": "media/dsstdfx.bin",
      "name": "dsstdfx"
    }
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "outputDir": "out/Debug",
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true
      }
    },
    "Release": {
      "configuration": "release",
      "outputDir": "out/Release",
      "imageBuild": {
        "stackSize": 65536,
        "debug": false,
        "noLogo": true,
        "noLibWarn": true
      }
    }
  }
}
