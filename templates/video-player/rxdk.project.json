{
  "name": "my-xmv",
  "sources": [
    "src/main.cpp"
  ],
  "deployPaths": [
    "media/test.xmv"
  ],
  "embed": [
    {
      "path": "media/dsstdfx.bin",
      "name": "dsstdfx"
    }
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "libraries": [
        "libxapid",
        "libd3d8d",
        "libdsoundd",
        "libxmvd",
        "libcd",
        "libcppd",
        "libkerneld",
        "libcompatd"
      ],
      "outputDir": "out/Debug",
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true
      }
    },
    "Release": {
      "configuration": "release",
      "libraries": [
        "libxapi",
        "libd3d8",
        "libdsound",
        "libxmv",
        "libc",
        "libcpp",
        "libkernel",
        "libcompat"
      ],
      "outputDir": "out/Release",
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true
      }
    }
  }
}
