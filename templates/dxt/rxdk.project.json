{
  "name": "my-dxt",
  "type": "dxt",
  "sources": [
    "src/main.c"
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "libraries": [
        "libxbdmd",
        "libkerneld",
        "libcd",
        "libcompatd"
      ],
      "outputDir": "out/Debug"
    },
    "Release": {
      "configuration": "release",
      "libraries": [
        "libxbdm",
        "libkernel",
        "libc",
        "libcompat"
      ],
      "outputDir": "out/Release"
    }
  }
}
