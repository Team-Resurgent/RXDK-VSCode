{
  "name": "my-dxt",
  "type": "dxt",
  "sources": [
    "src/main.c"
  ],
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "libraries": [
        "libxbdmd.lib",
        "libkerneld.lib",
        "libcd.lib",
        "libcompatd.lib"
      ],
      "outputDir": "out/Debug"
    },
    "Release": {
      "configuration": "release",
      "libraries": [
        "libxbdm.lib",
        "libkernel.lib",
        "libc.lib",
        "libcompat.lib"
      ],
      "outputDir": "out/Release"
    }
  }
}
